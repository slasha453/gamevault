# Required
DATABASE_URL=postgresql://postgres:password@localhost:5432/gamevault
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes

# Public app URL
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Cloudinary (required in production; optional locally)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Hosting / database
PORT=3000
NODE_ENV=development
TRUST_PROXY=0
DATABASE_SSL=0
DATABASE_SSL_REJECT_UNAUTHORIZED=0
DB_POOL_MAX=10
AUTH_COOKIE_NAME=gv_session

# Demo data (set to 1 only if you want demo users/listings on an empty DB)
SEED_DEMO=1
